# ---------------------------------------------------------------------------
# SecurePass - Variables de entorno
# Copia este archivo como ".env" y rellena valores reales antes de arrancar.
# NUNCA subas el archivo ".env" real a un repositorio (ya está en .gitignore).
# ---------------------------------------------------------------------------

# --- Django ---
# Genera una clave segura con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-genera-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo necesario si sirves la app en un dominio propio además de Render
# (RENDER_EXTERNAL_HOSTNAME ya se añade solo). Formato: https://tu-dominio.com
CSRF_TRUSTED_ORIGINS=

# --- Cifrado de contraseñas almacenadas (Fernet) ---
# Genera una clave con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme-genera-una-clave-fernet-de-32-bytes-base64

# --- Base de datos PostgreSQL ---
# Opción A (Docker Compose local): se usan estas variables sueltas, apuntando
# al servicio "db" del propio docker-compose.yml.
POSTGRES_DB=securepass_db
POSTGRES_USER=securepass_user
POSTGRES_PASSWORD=changeme-usa-una-contraseña-fuerte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Opción B (despliegue en Render + Neon/Supabase): define DATABASE_URL con la
# cadena de conexión que te da Neon/Supabase y se usará en vez de las
# variables POSTGRES_* de arriba (no hace falta borrarlas, simplemente se
# ignoran si DATABASE_URL está presente).
# DATABASE_URL=postgresql://usuario:password@ep-xxxxx.region.aws.neon.tech/securepass_db?sslmode=require
